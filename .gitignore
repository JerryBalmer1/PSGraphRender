# Build output
output/
*.nupkg

# Generated HTML reports exported to the repo root.
# Assets/graph.html is the template and lives under src/, so it is unaffected.
/*.html
# PowerShell
*.pssc
*.psd1.bak

# IDE / OS
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.user
*.suo
Thumbs.db
Desktop.ini
.DS_Store

# Local secrets / scratch
*.local.md
.env
.env.*

# Test / coverage
coverage/
# The build writes coverage under output/. A copy at the root means something
# ran Invoke-Pester directly, which defaults to the working directory.
coverage.xml
TestResults/
Pester*.xml

# InvokeBuild / tools cache
.tools/

# Corpus build output (generated, not source).
output/corpus/
